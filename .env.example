# ---------------------------------------------------------------------------
# Model provider selection for the workshop agents
# ---------------------------------------------------------------------------
# Leave everything below unset for the LOCAL-FIRST default: an Ollama model
# served on your machine, spoken to through Strands' OpenAI Chat Completions
# provider. Start Ollama first:  `ollama serve`  then  `ollama pull gemma4`
# ---------------------------------------------------------------------------

# Provider to use: "ollama" (default) or "bedrock".
MODEL_PROVIDER=ollama

# --- Ollama (local) -------------------------------------------------------
# OpenAI-compatible endpoint exposed by Ollama. Default shown.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Model tag you have pulled locally (`ollama pull llama3.1:8b`).
OLLAMA_MODEL_ID=gemma4:latest

# --- Amazon Bedrock (optional cloud provider) -----------------------------
# Required ONLY when MODEL_PROVIDER=bedrock. Set this to the Claude Sonnet 5
# inference-profile id that is enabled and available in your AWS account.
# BEDROCK_MODEL_ID=
# AWS region for Bedrock.
# AWS_REGION=us-east-1
# Optional Bedrock API key (bearer token). Omit to use standard AWS
# credentials (SigV4) from your environment / profile.
# BEDROCK_API_KEY=

# --- Logging --------------------------------------------------------------
# Strands log verbosity: debug | info | warn | error
STRANDS_LOG_LEVEL=info
